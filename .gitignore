# 项目内部数据，不纳入版本控制
.workbuddy/

# 默认忽略所有文件
*

# 仅保留 Markdown 文档与 .gitignore 本身
!*.md
!.gitignore

# docs 目录内的设计、规格与数据文件都是受控资产，必须整体可见。
# 只写 !*.md 不够：git 不会进入被 * 忽略的目录，目录下的新文档无法提交。
!docs/
!docs/**

# Keep the executable server scaffold and CI workflow visible to Git and tooling.
!server/
!server/**
!.github/
!.github/**
!docker-compose.yml

# Cocos Creator client project sources
!client/
!client/**

# Cocos Creator generated local/build caches
client/build/
client/library/
client/local/
client/temp/
client/logs/
client/node_modules/
client/profiles/
client/.DS_Store

# Art asset post-processing tooling (not runtime code)
!tools/
!tools/**
tools/__pycache__/
