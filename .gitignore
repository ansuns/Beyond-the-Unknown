# 项目内部数据，不纳入版本控制
.workbuddy/

# 默认忽略所有文件
*

# 仅保留 Markdown 文档与 .gitignore 本身
!*.md
!.gitignore

# Keep the executable server scaffold and CI workflow visible to Git and tooling.
!server/
!server/**
!.github/
!.github/**
!docker-compose.yml

# Cocos Creator client project sources
!client/
!client/**

# Cocos Creator generated local/build caches
client/build/
client/library/
client/local/
client/temp/
client/logs/
client/node_modules/
client/.DS_Store
